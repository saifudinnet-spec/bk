# Konfigurasi PRODUCTION (npm run build)
# File ini otomatis dibaca Vite saat mode production (npm run build).
#
# PETUNJUK SETUP DI SERVER:
# 1. Copy file ini: cp .env.production.example .env.production
# 2. Edit .env.production dan ganti URL dengan domain Anda
# 3. Jalankan: npm run build
# 4. Upload folder dist/ ke web server

# Ganti dengan URL subdomain API Anda (tanpa trailing slash)
VITE_API_BASE_URL=https://api.domain-anda.com
